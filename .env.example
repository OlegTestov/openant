# ── General ──────────────────────────────────────
SETUP_TOKEN=
SERVER_IP=
DOCKER_GID=999

# ── Ghost ────────────────────────────────────────
GHOST_URL=http://localhost
GHOST_DB_PASSWORD=
GHOST_DB_ROOT_PASSWORD=
GHOST_ADMIN_API_KEY=
GHOST_CONTENT_API_KEY=

# ── NocoDB ───────────────────────────────────────
DB_PASSWORD=
NOCODB_JWT_SECRET=
NOCODB_PUBLIC_URL=http://localhost:8080
NOCODB_PORT=8080
NOCODB_AUTH_TOKEN=
NOCODB_BASE_ID=
NOCODB_TABLE_ID=

# ── n8n ──────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
N8N_API_KEY=

# ── Domain ───────────────────────────────────────
DOMAIN=

# ── LLM ──────────────────────────────────────────
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_IMAGE_MODEL=

# ── Blog ─────────────────────────────────────────
BLOG_TITLE=
BLOG_DESCRIPTION=
BLOG_LANG=en
BLOG_TONE=professional
PUBLISH_INTERVAL_MINUTES=300

# ── Telegram ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID stored in NocoDB Prompts table, not in .env

# ── Social ───────────────────────────────────────
MAKE_WEBHOOK_URL=
PINTEREST_ENABLED=false
THREADS_ENABLED=false

# ── SEO ──────────────────────────────────────────
INDEXNOW_KEY=

# ── Instance Mode ────────────────────────────────
INSTANCE_MODE=byok

# ── Service Passwords (set by Control Plane or manually) ──
GHOST_ADMIN_PASSWORD=
NOCODB_ADMIN_PASSWORD=
N8N_ADMIN_PASSWORD=

# ── SaaS Mode (set by Control Plane) ─────────────
OPENANT_SAAS_MODE=false
OPENANT_SAAS_INSTANCE_ID=
OPENANT_SAAS_CALLBACK_URL=
OPENANT_SAAS_CALLBACK_SECRET=
